# QLI Build Log Summarizer configuration
#
# Copy this file to `.env` and export the values, or set them in the shell
# that runs `qli-buildlog-summary`. Every setting is optional; the defaults
# below are what the tool uses when a variable is unset.

# Purpose: Directory that relative log-file paths resolve against.
# Type: Absolute directory path.
# Required: No. Default: the current working directory.
# Safe example: /var/log/qli
QLI_LOG_DIR=

# Purpose: Output format for the summary printed to stdout.
# Type: One of text, json.
# Required: No. Default: text.
SUMMARY_FORMAT=text

# Purpose: Logging verbosity on stderr. `debug` prints parse statistics.
# Type: One of debug, info.
# Required: No. Default: info.
LOG_LEVEL=info
